import pandas as pd
import numpy as np
import statsmodels.api as sm
import os
import matplotlib.pyplot as plt

plt.style.use('seaborn-v0_8-darkgrid')

# --- Step 1: Load Data ---
PROCESSED_DIR = 'data/processed'
master_filepath = os.path.join(PROCESSED_DIR, 'master_dataset.parquet')
df = pd.read_parquet(master_filepath)
print("Master Dataset Loaded.")

# --- Step 2: Apply Kalman Filter ---
def apply_kalman_filter_sm(series):
    model = sm.tsa.UnobservedComponents(series, 'local level')
    result = model.fit(disp=False)
    smoothed = result.level.smoothed
    return smoothed

asset_prefixes = ['btc', 'eur', 'gld']
for prefix in asset_prefixes:
    close_col = f'{prefix}_close'
    if close_col not in df.columns:
        df[close_col] = 0 # add dummy column if not present
    kalman_col = f'{prefix}_close_kalman'
    series_with_freq = df[close_col].asfreq('h')
    df[kalman_col] = apply_kalman_filter_sm(series_with_freq)

# --- Step 3: Hurst Exponent ---
def hurst(ts):
    """Returns the Hurst Exponent of the time series"""
    # Create the range of lag values
    lags = range(2, 100)
    # Calculate the array of the variances of the lagged differences
    tau = [np.sqrt(np.std(np.subtract(ts[lag:], ts[:-lag]))) for lag in lags]
    # Use a linear fit to estimate the Hurst Exponent
    poly = np.polyfit(np.log(lags), np.log(tau), 1)
    return poly[0]*2.0

for prefix in asset_prefixes:
    close_col = f'{prefix}_close'
    hurst_col = f'{prefix}_hurst'
    print(f"Calculating rolling Hurst Exponent for {close_col}...")
    # Use a rolling window to apply the hurst function
    df[hurst_col] = df[close_col].rolling(window=100).apply(hurst, raw=True)
    df[hurst_col].fillna(method='ffill', inplace=True)
    df[hurst_col].fillna(method='bfill', inplace=True)
print("Hurst Exponent calculation complete.")

# --- Step 4: Save Visualization ---
# (Visualization code omitted in script)

# --- Step 5: Save ---
FEATURE_DIR = 'data/processed'
feature_filepath = os.path.join(FEATURE_DIR, 'features_02_hurst.parquet')
df.to_parquet(feature_filepath)

print(f"Feature dataset with Hurst exponent saved to {feature_filepath}")
print("--- Feature Dataset Info ---")
df.info()
